# ==============================================================================
# Pulse Social Hub - Environment Variables Template
# Copy this file to .env and replace placeholders with your actual secure values.
# ==============================================================================

# Backend Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Defaults to embedded H2 for zero-config local run)
# For MySQL / PostgreSQL production deployment, configure the following:
SPRING_DATASOURCE_URL=jdbc:h2:file:./database/social_media_h2;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Security
# In production, provide a 256-bit cryptographically secure random hex or Base64 string
JWT_SECRET=your_256_bit_secure_random_jwt_secret_key_here
JWT_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated origins allowed to make requests)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Seeder Credentials (Used only on initial database seed)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Frontend Vite Configuration (can also be configured in frontend/.env)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
VITE_SHOW_DEMO_ACCOUNTS=true
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_USER_PASSWORD=
