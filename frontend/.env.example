# Pulse Social Hub - Frontend Environment Variables Template
# Copy this file to frontend/.env for custom local or production frontend overrides.

# API Base URL (default connects to local Spring Boot backend)
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket URL for real-time messaging and notifications
VITE_WS_URL=ws://localhost:8080/ws

# Show or hide quick demo account login buttons on LoginPage
VITE_SHOW_DEMO_ACCOUNTS=true

# Passwords for quick demo login buttons (leave matching backend seed credentials)
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_USER_PASSWORD=
